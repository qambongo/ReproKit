{
  "manifest_version": 3,
  "name": "ReproKit: bug capture for QA",
  "short_name": "ReproKit",
  "version": "1.0.0",
  "description": "Capture screen recordings or the last minutes of any tab as shareable bug reports.",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "ReproKit",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "unlimitedStorage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["inpage.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["http://*/*", "https://*/*"], "js": ["bridge.js"], "run_at": "document_start" }
  ],
  "commands": {
    "capture": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Capture a bug report from the current tab"
    }
  }
}
